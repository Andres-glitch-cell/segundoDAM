<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Arriba a la izquierda: LEFT | TOP -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="left|top"
        android:background="#FFE0A3" />

    <!-- 2. Arriba en el centro: CENTER_HORIZONTAL | TOP -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal|top"
        android:background="#FFE0A3" />

    <!-- 3. Arriba a la derecha: RIGHT | TOP -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="right|top"
        android:background="#FFE0A3" />

    <!-- 4. Centro izquierda: CENTER_VERTICAL | LEFT -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_vertical|left"
        android:background="#FFE0A3" />

    <!-- 5. Centro: CENTER -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="#FFE0A3" />

    <!-- 6. Centro derecha: CENTER_VERTICAL | RIGHT -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_vertical|right"
        android:background="#FFE0A3" />

    <!-- 7. Abajo a la izquierda: LEFT | BOTTOM -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="left|bottom"
        android:background="#FFE0A3" />

    <!-- 8. Abajo en el centro: CENTER_HORIZONTAL | BOTTOM -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal|bottom"
        android:background="#FFE0A3" />

    <!-- 9. Abajo a la derecha: RIGHT | BOTTOM -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="right|bottom"
        android:background="#FFE0A3" />

</FrameLayout>