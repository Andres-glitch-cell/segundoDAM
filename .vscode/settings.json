  // ============================================================
  // ✨ EDITOR
  // ============================================================
  "editor.fontFamily": "Cascadia Code, JetBrains Mono, Fira Code, Consolas, monospace",
  "editor.fontSize": 15,
  "editor.lineHeight": 1.55,
  "editor.letterSpacing": 0.2,
  "editor.fontWeight": "400",
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.smoothScrolling": true,
  "editor.scrollBeyondLastLine": false,
  "editor.scrollbar.vertical": "visible",
  "editor.scrollbar.horizontal": "visible",
  "editor.scrollbar.verticalScrollbarSize": 10,
  "editor.scrollbar.horizontalScrollbarSize": 10,
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "all",
  "editor.renderFinalNewline": "dimmed",
  "editor.renderValidationDecorations": "on",
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": true,
  "editor.minimap.maxColumn": 120,
  "editor.minimap.scale": 1,
  "editor.minimap.showSlider": "mouseover",
  "editor.minimap.autohide": "none",
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 5,
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.matchBrackets": "always",
  "editor.codeLens": true,
  "editor.inlayHints.enabled": "on",
  "editor.lightbulb.enabled": "on",
  "editor.hover.enabled": "on",
  "editor.hover.delay": 200,
  "editor.parameterHints.enabled": true,
  "editor.suggest.localityBonus": true,
  "editor.suggest.preview": true,
  "editor.suggest.showMethods": true,
  "editor.suggest.showFunctions": true,
  "editor.suggest.showConstructors": true,
  "editor.suggest.showDeprecated": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": true
  },
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.inlineSuggest.enabled": true,
  // ============================================================
  // 📐 FORMATO
  // ============================================================
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": true,
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  // ============================================================
  // 🔎 BÚSQUEDA / SELECCIÓN
  // ============================================================
  "search.smartCase": true,
  "search.useIgnoreFiles": true,
  "search.followSymlinks": true,
  // ============================================================
  // 🧭 BREADCRUMBS
  // ============================================================
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",
  "breadcrumbs.symbolSortOrder": "position",
  // ============================================================
  // 📁 EXPLORER
  // ============================================================
  "explorer.compactFolders": false,
  "explorer.sortOrder": "type",
  "explorer.sortOrderLexicographicOptions": "upper",
  "explorer.decorations.badges": true,
  "explorer.decorations.colors": true,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": true,
  // ============================================================
  // 📂 FILES
  // ============================================================
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": false
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.hg/store/**": true
  },
  "files.associations": {
    "*.env": "dotenv",
    ".env.*": "dotenv",
    "*.blade.php": "blade"
  },
  // ============================================================
  // 🖥️ TERMINAL
  // ============================================================
  "terminal.integrated.fontFamily": "Cascadia Code, JetBrains Mono, Fira Code, monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
