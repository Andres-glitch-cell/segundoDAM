<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UD02 Actividad 02 - TextView"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="16dp" />

    <!-- Ejercicio 1: Configurado en XML -->
    <TextView
        android:id="@+id/tv_ejercicio1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/texto_xml_ej1"
        android:textSize="16sp"
        android:textColor="#0066CC"
        android:textStyle="italic"
        android:background="#E6F2FF"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Ejercicio 2: Configurado en Java -->
    <TextView
        android:id="@+id/tv_ejercicio2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Ejercicio 3: Mixto (XML + Java) -->
    <TextView
        android:id="@+id/tv_ejercicio3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/texto_xml_ej3_parte1"
        android:textSize="16sp"
        android:textColor="#222222"
        android:background="#F0F0F0"
        android:padding="12dp" />

</LinearLayout>
