<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Pantalla de la calculadora -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.5"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="20dp"
        android:paddingBottom="45dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/txtOperacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="35sp"
            android:textColor="#000000"
            android:gravity="end"
            android:maxLines="2"/>

        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="25sp"
            android:textColor="#000000"
            android:gravity="end"
            android:paddingTop="18dp"/>

    </LinearLayout>

    <!-- Zona de botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6.5"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Teclado numérico -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <Button
                style="@style/CalcButton.Clear"
                android:text="C"
                android:onClick="onButtonClick"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DADADA"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <Button style="@style/CalcButton" android:text="7" android:onClick="onButtonClick"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5E5E5"/>
                <Button style="@style/CalcButton" android:text="8" android:onClick="onButtonClick"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5E5E5"/>
                <Button style="@style/CalcButton" android:text="9" android:onClick="onButtonClick"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DADADA"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <Button style="@style/CalcButton" android:text="4" android:onClick="onButtonClick"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5E5E5"/>
                <Button style="@style/CalcButton" android:text="5" android:onClick="onButtonClick"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5E5E5"/>
                <Button style="@style/CalcButton" android:text="6" android:onClick="onButtonClick"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DADADA"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <Button style="@style/CalcButton" android:text="1" android:onClick="onButtonClick"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5E5E5"/>
                <Button style="@style/CalcButton" android:text="2" android:onClick="onButtonClick"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5E5E5"/>
                <Button style="@style/CalcButton" android:text="3" android:onClick="onButtonClick"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DADADA"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <Button style="@style/CalcButton" android:text="." android:onClick="onButtonClick"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5E5E5"/>
                <Button style="@style/CalcButton" android:text="0" android:onClick="onButtonClick"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5E5E5"/>
                <Button style="@style/CalcButton" android:text="⌫" android:onClick="onButtonClick"/>
            </LinearLayout>

        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#DADADA"/>

        <!-- Columna de operaciones -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@color/calculator_primary">

            <Button style="@style/CalcButton.Clear" android:text="/" android:onClick="onButtonClick"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/calculator_divider"/>
            <Button style="@style/CalcButton.Operator" android:text="×" android:onClick="onButtonClick"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/calculator_divider"/>
            <Button style="@style/CalcButton.Operator" android:text="-" android:onClick="onButtonClick"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/calculator_divider"/>
            <Button style="@style/CalcButton.Operator" android:text="+" android:onClick="onButtonClick"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/calculator_divider"/>
            <Button style="@style/CalcButton.Operator" android:text="=" android:onClick="onButtonClick"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
